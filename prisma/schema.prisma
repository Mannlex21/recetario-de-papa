generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// Configuración general del sistema (Límites dinámicos, flags, etc.)
model AppConfig {
    key   String @id
    value Int

    @@map("app_config")
}

// Rastrear el uso diario por IP, usuario o sesión
model UserUsage {
    id              String   @id @default(cuid())
    identifier      String   @unique // Puede ser IP o User ID
    userId          String?  @map("user_id")
    user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    dailyCount      Int      @default(0) @map("daily_count")
    lastRequestDate DateTime @default(now()) @map("last_request_date") @db.Date

    @@map("user_usage")
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    nombre    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    recetas     Receta[]
    menusSemana MenuSemanal[]
    favoritos   Favorito[]
    usage       UserUsage[]

    @@map("User")
}

model Receta {
    id                   String   @id @default(cuid())
    titulo               String
    slug                 String   @unique
    descripcion          String
    instrucciones        String
    tiempoPreparacionInt Int
    porciones            Int      @default(1)
    imagenUrl            String?
    categoria            String
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    userId       String
    user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    ingredientes IngredienteReceta[]
    itemMenu     ItemMenuSemanal[]
    favoritos    Favorito[]
    etiquetas    Etiqueta[]          @relation("RecetaEtiquetas")
}

model IngredienteReceta {
    id       String @id @default(cuid())
    recetaId String
    receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

    nombre   String
    cantidad String
}

model MenuSemanal {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    semana    String
    createdAt DateTime @default(now())

    items ItemMenuSemanal[]
}

model ItemMenuSemanal {
    id            String      @id @default(cuid())
    menuSemanalId String
    menuSemanal   MenuSemanal @relation(fields: [menuSemanalId], references: [id], onDelete: Cascade)

    recetaId String
    receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

    diaSemana  String
    tipoComida String
}

model Favorito {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    recetaId String
    receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, recetaId])
}

model Etiqueta {
    id      String   @id @default(cuid())
    nombre  String   @unique
    recetas Receta[] @relation("RecetaEtiquetas")
}
